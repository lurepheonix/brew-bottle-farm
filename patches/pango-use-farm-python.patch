# Formula: pango
# Upstream version tested: 1.58.2
# Tool: python@3.15 3.15.1 (build-deps.conf) via farm shim-keg
# Why safe: gobject-introspection + meson :build qualify to the farm-bottled copies; python@3.15 :build uses the farm shim-keg (meson scripts shell out to bare python3); env :std exposes the toolchain interpreter; meson compile capped at -j2 (guest fork-EAGAIN at full parallelism)
# Core SHA: 5b9e2dcf056c207fd90b18100ece057a4acc4ccc
--- a/Formula/pango.rb
+++ b/Formula/pango.rb
@@ -24,10 +24,19 @@
     sha256 cellar: :any, x86_64_linux:      "29de9540633d5eff78b7cc37b5c40bad05ddeef1f50ceb7de8c762691f5a3a5e"
   end
 
-  depends_on "gobject-introspection" => :build
-  depends_on "meson" => :build
+  # brew-bottle-farm: qualify intra-queue deps to the farm-bottled copies
+  # (single-sourced per install; see patches/README.md).
+  # depends_on "gobject-introspection" => :build  # disabled — see patches/README.md
+  depends_on "farm/local/gobject-introspection" => :build
+  # depends_on "meson" => :build  # disabled — see patches/README.md
+  depends_on "farm/local/meson" => :build
+  env :std  # passthrough env so farm bottled tools resolve their toolchain interpreter (superenv would scrub uv from PATH)
   depends_on "ninja" => :build
   depends_on "pkgconf" => [:build, :test]
+  # brew-bottle-farm: core python unpourable on Tier-3 guests; use the farm
+  # shim-keg (pinned uv/asdf interpreter via farm-toolchain shims).
+  # depends_on "python@3.15" => [:build, :test]  # disabled — see patches/README.md
+  depends_on "farm/local/python@3.15" => [:build, :test]
   depends_on "cairo"
   depends_on "fontconfig"
   depends_on "freetype"
@@ -49,7 +58,7 @@
     ]
 
     system "meson", "setup", "build", *args, *std_meson_args
-    system "meson", "compile", "-C", "build", "--verbose"
+    system "meson", "compile", "-j2", "-C", "build", "--verbose"  # brew-bottle-farm: cap jobs (8c16GB guest fork-EAGAIN at full parallelism; cf. glib/watchman)
     system "meson", "install", "-C", "build"
   end
 

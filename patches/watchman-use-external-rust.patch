# Formula: watchman
# Upstream version tested: 2026.10.26.00
# Tool: rust 1.100.0 (build-deps.conf) via rustup
# Why safe: depends_on "rust" => :build only, no linkage (brew linkage --test clean), cmake-driven build; serial cargo + make -j2 tame nested parallelism (guest spawn EAGAIN)
# Core SHA: df69c4ae50a5c295943b98a727fcc48fd0c8d585
--- a/Formula/watchman.rb
+++ b/Formula/watchman.rb
@@ -26,7 +26,9 @@
   depends_on "openssl@4" => :build
   depends_on "pkgconf" => :build
   depends_on "python-setuptools" => :build
-  depends_on "rust" => :build
+  # brew-bottle-farm: external rustup 1.100.0 (build-deps.conf). Requires $CARGO_HOME on PATH.
+  # depends_on "rust" => :build  # disabled — see patches/README.md
+  env :std  # passthrough env so toolchain cargo is visible (superenv would scrub PATH)
   depends_on "edencommon"
   depends_on "fb303"
   depends_on "fbthrift"
@@ -51,6 +53,14 @@
   end
 
   def install
+    # brew-bottle-farm: cap nested parallelism — cmake -j8 drives cargo,
+    # which defaults to -j8 itself (64-way oversubscription OOMs the 16GB
+    # guest: posix_spawn EAGAIN). C++ level keeps -j8.
+    ENV["CARGO_BUILD_JOBS"] = "1"
+    # brew-bottle-farm: keep :std for toolchain cargo PATH, but drop brew's
+    # stale CLT CPATH — it injects CLT C headers ahead of libc++ and breaks
+    # header search order (same class as the mist-cli SDKROOT/CPATH scrub).
+    ENV.delete "CPATH"
     # Match the F14 ABI in bottled Folly instead of compiling for the host CPU.
     if OS.linux? && Tab.for_formula(Formula["folly"]).built_as_bottle
       ENV["HOMEBREW_OPTFLAGS"] = Hardware::CPU.optimization_flags.fetch(Hardware.oldest_cpu)
@@ -82,7 +92,10 @@
     args << "-DCMAKE_EXE_LINKER_FLAGS=-Wl,-dead_strip_dylibs" if OS.mac?
 
     system "cmake", "-S", ".", "-B", "build", *args, *std_cmake_args
-    system "cmake", "--build", "build"
+    # brew-bottle-farm: cap make-level parallelism (see CARGO_BUILD_JOBS
+    # above — full -j8 plus nested cargo exhausts the 16GB guest and spawns
+    # fail with EAGAIN even at -j4/-j2).
+    system "cmake", "--build", "build", "--parallel", "2"
     system "cmake", "--install", "build"
 
     path = Pathname.new(File.join(prefix, HOMEBREW_PREFIX))

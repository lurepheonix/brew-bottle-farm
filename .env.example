# brew-bottle-farm local config (NON-SECRETS ONLY — never put tokens here).
# Copy to .env (gitignored) and fill in. Only the keys below are imported.
# Token pointers only — the value lives in the Keychain or a 600 file.

# Release target (required for real publishes; never inferred from cwd):
TAP_REPO=<user>/homebrew-intel

# Token pointer — pick one (GH_TOKEN env always wins when set):
# FARM_TOKEN_FILE=$HOME/.private-farm-tap-token
# FARM_TOKEN_KEYCHAIN_ITEM=farm-tap-token
